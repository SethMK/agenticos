---
/**
 * StackedBarSprintComparison.astro — S094 (extracted as shared base)
 *
 * Parameterised stacked-bar comparison renderer for per-sprint plan-vs-actual
 * accuracy charts. Each closed sprint renders as a group of two stacked
 * columns (A = expected, B = observed), each column with two segments
 * (must-have bottom + overhead top). Variance ratio = sumB / sumA;
 * columns where ratio > varianceFlagThreshold get a ↑ glyph in --danger.
 *
 * Consumers (current):
 *   - SprintAccuracyTokens.astro (S094) — token extractors, unit 'k'
 *   - SprintAccuracyTime.astro   (S095) — minute extractors, unit 'min'
 *
 * Constraints (carried from S088/S096):
 *   - Hand-rolled SVG, zero client JS.
 *   - Design tokens only inside <style> chart elements (no hex).
 *   - preserveAspectRatio="xMidYMid meet" — never "none" (S069 bug).
 *   - Axis tick labels rendered as in-SVG <text> so they share the SVG
 *     coordinate system with the bars (S096 alignment fix).
 *   - Empty-state: no axes / no flags / no reference scaffolding.
 */

interface ClosedSprint {
  sprint_id: string;
  planned_must_have_budget_k: number;
  planned_overhead_budget_k: number;
  actual_must_have_tokens_k: number;
  actual_overhead_tokens_k: number;
  actual_work_tokens_k: number;
  actual_total_tokens_k: number;
  planned_duration_min: number;
  actual_wall_clock_min: number;
  must_have_shipped_ids?: string[];
  [key: string]: unknown;
}

interface ColumnExtract {
  mustK: number;
  overheadK: number;
}

interface Props {
  data: ClosedSprint[];
  columnAExtractor: (s: ClosedSprint) => ColumnExtract;
  columnBExtractor: (s: ClosedSprint) => ColumnExtract;
  columnALabel: string;
  columnBLabel: string;
  axisLabel: string;
  unitSuffix: 'k' | 'min';
  varianceFlagThreshold: number;
  title: string;
  footerText?: string;
  ariaLabel: string;
  windowSize?: number;       // S113: last-N main panel
  showOverview?: boolean;    // S113: render overview strip + window-rect
}

const {
  data,
  columnAExtractor,
  columnBExtractor,
  columnALabel,
  columnBLabel,
  axisLabel,
  unitSuffix,
  varianceFlagThreshold,
  title,
  footerText,
  ariaLabel,
  windowSize = 10,
  showOverview = true,
} = Astro.props as Props;

// S113: dual-panel. overviewData = ALL sprints (full history); displayData =
// last-windowSize sprints when overview is on and history exceeds the window.
const overviewData = data;
const overviewActive = showOverview && data.length > windowSize;
const displayData = overviewActive ? data.slice(-windowSize) : data;

const hasSprints = displayData.length > 0;

// ── Per-sprint extraction + flag ──────────────────────────────────────────
const sprints = displayData.map(s => {
  const a = columnAExtractor(s);
  const b = columnBExtractor(s);
  const aTotal = a.mustK + a.overheadK;
  const bTotal = b.mustK + b.overheadK;
  const ratio = aTotal > 0 ? bTotal / aTotal : 0;
  const isOverrun = ratio > varianceFlagThreshold;
  return {
    sprint_id: s.sprint_id,
    a, b, aTotal, bTotal, ratio, isOverrun,
  };
});

// S112: median-normalized scale. Cap chart at median(actual) × 2.5 so a
// single outlier sprint doesn't flatten the rest. Y_MAX raised to maxPlan
// when plans exceed the cap (plans always render fully; only actuals get
// the off-scale glyph treatment).
const sortedActuals = sprints
  .map(s => s.bTotal)
  .filter(v => v > 0)
  .sort((a, b) => a - b);
const medianActual = sortedActuals.length > 0
  ? sortedActuals[Math.floor(sortedActuals.length / 2)]
  : 0;
const Y_CAP = medianActual * 2.5;
const maxPlan = sprints.reduce((m, s) => Math.max(m, s.aTotal), 0);
const Y_MAX = Math.max(Y_CAP, maxPlan) || 100;

// ── SVG geometry ──────────────────────────────────────────────────────────
const VB_W = 600;
const VB_H = 220;
const PAD_TOP    = 30;  // S112: room for off-scale glyph above chart
const PAD_BOTTOM = 48;  // x-axis (sprint id) + "plan/actual" sub-label row
const PAD_LEFT   = 32;  // y-axis tick labels live in SVG, need room
const PAD_RIGHT  = 8;

const PLOT_W = VB_W - PAD_LEFT - PAD_RIGHT;
const PLOT_H = VB_H - PAD_TOP - PAD_BOTTOM;

function yV(v: number): number {
  const clipped = Math.min(v, Y_MAX);
  return PAD_TOP + PLOT_H * (1 - clipped / Y_MAX);
}

const n = sprints.length;
const slotW = n > 0 ? PLOT_W / n : 0;
// Within each sprint slot: [outer-gap][bar A][inner-gap][bar B][outer-gap]
// 0.15 + 0.30 + 0.10 + 0.30 + 0.15 = 1.00
const barW    = slotW * 0.30;
const gapOuter = slotW * 0.15;
const gapInner = slotW * 0.10;

function xA(i: number): number { return PAD_LEFT + slotW * i + gapOuter; }
function xB(i: number): number { return xA(i) + barW + gapInner; }
function xSlotCenter(i: number): number { return PAD_LEFT + slotW * (i + 0.5); }

// ── Y-axis ticks ──────────────────────────────────────────────────────────
const Y_TICK_COUNT = 4;
const yTicks = Array.from({ length: Y_TICK_COUNT }, (_, i) => {
  const v = (Y_MAX / (Y_TICK_COUNT - 1)) * i;
  return { v, svgY: yV(v) };
});

function fmt(v: number): string {
  if (unitSuffix === 'k') {
    if (v >= 1000) return `${(v / 1000).toFixed(1)}M`;
    return `${Math.round(v)}k`;
  }
  // unitSuffix === 'min'
  return `${Math.round(v)}m`;
}

// ── Bar segment geometry ──────────────────────────────────────────────────
const bars = sprints.map((s, i) => {
  const aX = xA(i);
  const bX = xB(i);

  // Column A (plan) — must bottom, overhead top
  const aMustTopY = yV(s.a.mustK);
  const aMustH    = yV(0) - aMustTopY;
  const aOhTopY   = yV(s.a.mustK + s.a.overheadK);
  const aOhH      = aMustTopY - aOhTopY;

  // Column B (actual) — must bottom, overhead top
  const bMustTopY = yV(s.b.mustK);
  const bMustH    = yV(0) - bMustTopY;
  const bOhTopY   = yV(s.b.mustK + s.b.overheadK);
  const bOhH      = bMustTopY - bOhTopY;

  return {
    sprint_id: s.sprint_id,
    aX, bX,
    aMustTopY, aMustH, aOhTopY, aOhH,
    bMustTopY, bMustH, bOhTopY, bOhH,
    aTotal: s.aTotal,
    bTotal: s.bTotal,
    aMustK: s.a.mustK,
    aOhK: s.a.overheadK,
    bMustK: s.b.mustK,
    bOhK: s.b.overheadK,
    ratio: s.ratio,
    isOverrun: s.isOverrun,
    isOffScale: s.bTotal > Y_MAX,
    slotCenterX: xSlotCenter(i),
  };
});

const capLineY = yV(Y_CAP);
const showCapLine = hasSprints && Y_CAP > 0 && Y_CAP < Y_MAX;

const xTickLabelY = VB_H - 30;
const xSubLabelY  = VB_H - 16;
const yTickLabelX = PAD_LEFT - 4;

// ── S113: overview strip geometry ─────────────────────────────────────────
// Compressed proportional bars for ALL N sprints. Own y-scale (rawMax of
// overview actuals — NOT the main panel's Y_CAP). Static window-rect overlay
// marks the slots covered by displayData.
const OV_VB_W = VB_W;
const OV_VB_H = 50;
const OV_PAD_LEFT = PAD_LEFT;
const OV_PAD_RIGHT = PAD_RIGHT;
const OV_PAD_TOP = 4;
const OV_PAD_BOTTOM = 6;
const OV_PLOT_W = OV_VB_W - OV_PAD_LEFT - OV_PAD_RIGHT;
const OV_PLOT_H = OV_VB_H - OV_PAD_TOP - OV_PAD_BOTTOM;
const OV_BASELINE_Y = OV_VB_H - OV_PAD_BOTTOM;

const overviewSprints = overviewData.map(s => {
  const a = columnAExtractor(s);
  const b = columnBExtractor(s);
  const aTotal = a.mustK + a.overheadK;
  const bTotal = b.mustK + b.overheadK;
  const ratio = aTotal > 0 ? bTotal / aTotal : 0;
  return { sprint_id: s.sprint_id, aTotal, bTotal, isOverrun: ratio > varianceFlagThreshold };
});
const overviewMax = overviewSprints.reduce(
  (m, s) => Math.max(m, s.aTotal, s.bTotal),
  0,
) || 1;
const ovN = overviewSprints.length;
const ovSlotW = ovN > 0 ? OV_PLOT_W / ovN : 0;
const ovBarW  = Math.max(2, Math.min(5, ovSlotW * 0.30));
const ovGapBetween = Math.max(1, ovSlotW * 0.08);

function ovX(i: number): number {
  return OV_PAD_LEFT + ovSlotW * i + (ovSlotW - (ovBarW * 2 + ovGapBetween)) / 2;
}
function ovBarH(v: number): number {
  return OV_PLOT_H * (v / overviewMax);
}

const overviewBars = overviewSprints.map((s, i) => {
  const planH = ovBarH(s.aTotal);
  const actH  = ovBarH(s.bTotal);
  const planX = ovX(i);
  const actX  = planX + ovBarW + ovGapBetween;
  return {
    sprint_id: s.sprint_id,
    planX, actX, planH, actH,
    planY: OV_BASELINE_Y - planH,
    actY:  OV_BASELINE_Y - actH,
    isOverrun: s.isOverrun,
  };
});

// Window-rect: covers the slots [ovN - displayData.length .. ovN - 1].
const windowStartI = Math.max(0, ovN - displayData.length);
const windowRectX  = OV_PAD_LEFT + ovSlotW * windowStartI;
const windowRectW  = ovSlotW * displayData.length;
---

<section
  class="stacked-comparison"
  aria-label={ariaLabel}
>
  <header class="head">
    <h2 class="title">
      <span class="glyph" aria-hidden="true">◆</span> {title}
    </h2>
    {hasSprints && (
      <div class="head-meta">
        <span class="count">{data.length}</span>
        <span class="sep">closed sprint{data.length === 1 ? '' : 's'}</span>
        <span class="sep">·</span>
        <span class="axis-meta">{axisLabel}</span>
        <span class="sep">·</span>
        <span class="threshold">overrun {varianceFlagThreshold}×</span>
      </div>
    )}
  </header>

  <div class="chart-outer">
    <div class="chart-wrap">
      <svg
        class="chart-svg"
        viewBox={`0 0 ${VB_W} ${VB_H}`}
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label={ariaLabel}
      >
        {hasSprints ? (
          <>
            {yTicks.map(t => (
              <line
                class="grid-line"
                x1={PAD_LEFT} x2={VB_W - PAD_RIGHT}
                y1={t.svgY}   y2={t.svgY}
              />
            ))}

            {showCapLine && (
              <>
                <line
                  class="cap-line"
                  x1={PAD_LEFT} x2={VB_W - PAD_RIGHT}
                  y1={capLineY} y2={capLineY}
                />
                <text
                  class="cap-label"
                  x={PAD_LEFT + 2} y={capLineY - 2}
                >CAP {fmt(Y_CAP)} (median×2.5)</text>
              </>
            )}

            {bars.map(b => (
              <g class="bar-group" data-sprint-id={b.sprint_id}>
                {/* Column A (plan) — must (bottom) + overhead (top) */}
                {b.aMustH > 0 && (
                  <rect
                    class="seg-plan-must"
                    x={b.aX} y={b.aMustTopY}
                    width={barW} height={b.aMustH}
                  >
                    <title>{b.sprint_id} plan · must {fmt(b.aMustK)}</title>
                  </rect>
                )}
                {b.aOhH > 0 && (
                  <rect
                    class="seg-plan-overhead"
                    x={b.aX} y={b.aOhTopY}
                    width={barW} height={b.aOhH}
                  >
                    <title>{b.sprint_id} plan · overhead {fmt(b.aOhK)} (plan total {fmt(b.aTotal)})</title>
                  </rect>
                )}

                {/* Column B (actual) — must (bottom) + overhead (top) */}
                {b.bMustH > 0 && (
                  <rect
                    class="seg-actual-must"
                    x={b.bX} y={b.bMustTopY}
                    width={barW} height={b.bMustH}
                  >
                    <title>{b.sprint_id} actual · must {fmt(b.bMustK)}</title>
                  </rect>
                )}
                {b.bOhH > 0 && (
                  <rect
                    class="seg-actual-overhead"
                    x={b.bX} y={b.bOhTopY}
                    width={barW} height={b.bOhH}
                  >
                    <title>{b.sprint_id} actual · overhead {fmt(b.bOhK)} (actual total {fmt(b.bTotal)} · {b.ratio.toFixed(2)}× plan)</title>
                  </rect>
                )}

                {/* Overrun glyph (column B top, --danger) */}
                {b.isOverrun && (
                  <text
                    class="overrun-glyph"
                    x={b.bX + barW / 2}
                    y={b.isOffScale ? PAD_TOP - 2 : b.bOhTopY - 4}
                    text-anchor="middle"
                  >
                    ↑
                    <title>{b.sprint_id} overrun · actual {fmt(b.bTotal)} = {b.ratio.toFixed(2)}× plan {fmt(b.aTotal)} (threshold {varianceFlagThreshold}×)</title>
                  </text>
                )}

                {/* Off-scale glyph (S112) — actual exceeds Y_MAX; render "↑ NNNm" above cap */}
                {b.isOffScale && (
                  <text
                    class="offscale-glyph"
                    x={b.bX + barW / 2}
                    y={PAD_TOP - 12}
                    text-anchor="middle"
                  >
                    ↑ {fmt(b.bTotal)}
                    <title>{b.sprint_id} actual {fmt(b.bTotal)} — off scale (cap {fmt(Y_CAP)})</title>
                  </text>
                )}

                {/* Per-column sub-labels (plan / actual) */}
                <text
                  class="col-sublabel"
                  x={b.aX + barW / 2} y={xSubLabelY}
                  text-anchor="middle"
                >{columnALabel}</text>
                <text
                  class="col-sublabel"
                  x={b.bX + barW / 2} y={xSubLabelY}
                  text-anchor="middle"
                >{columnBLabel}</text>
              </g>
            ))}

            {/* Y-axis tick labels */}
            {yTicks.map(t => (
              <text
                class="ytick-text"
                x={yTickLabelX} y={t.svgY + 3}
                text-anchor="end"
              >{fmt(t.v)}</text>
            ))}

            {/* X-axis sprint id labels */}
            {bars.map(b => (
              <text
                class="xtick-text"
                x={b.slotCenterX} y={xTickLabelY}
                text-anchor="middle"
              >{b.sprint_id.replace(/^SPR-?/, '')}</text>
            ))}
          </>
        ) : (
          <text
            class="empty-text"
            x={VB_W / 2} y={VB_H / 2}
            text-anchor="middle"
            dominant-baseline="middle"
          >No closed sprints yet</text>
        )}
      </svg>
    </div>
  </div>

  {overviewActive && (
    <>
      <p class="window-caption">showing last {displayData.length} of {data.length} sprints</p>
      <div class="overview-wrap">
        <svg
          class="chart-svg overview-svg"
          viewBox={`0 0 ${OV_VB_W} ${OV_VB_H}`}
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label={`Overview · all ${data.length} sprints, last ${displayData.length} highlighted`}
        >
          {overviewBars.map(b => (
            <>
              {b.planH > 0 && (
                <rect
                  class="ov-plan"
                  x={b.planX} y={b.planY}
                  width={ovBarW} height={b.planH}
                >
                  <title>{b.sprint_id} plan {fmt(b.planH * overviewMax / OV_PLOT_H)}</title>
                </rect>
              )}
              {b.actH > 0 && (
                <rect
                  class={b.isOverrun ? 'ov-actual ov-actual-overrun' : 'ov-actual'}
                  x={b.actX} y={b.actY}
                  width={ovBarW} height={b.actH}
                >
                  <title>{b.sprint_id} actual</title>
                </rect>
              )}
            </>
          ))}

          {/* Static window-rect overlay — marks slots covered by main panel */}
          <rect
            class="window-rect"
            x={windowRectX} y={0}
            width={windowRectW} height={OV_VB_H}
          />

          {/* Baseline */}
          <line
            class="ov-baseline"
            x1={OV_PAD_LEFT} x2={OV_VB_W - OV_PAD_RIGHT}
            y1={OV_BASELINE_Y} y2={OV_BASELINE_Y}
          />
        </svg>
      </div>
    </>
  )}

  {hasSprints && (
    <div class="legend" aria-hidden="true">
      <span class="legend-item">
        <span class="legend-swatch legend-plan-must"></span>
        plan · must
      </span>
      <span class="legend-item">
        <span class="legend-swatch legend-plan-overhead"></span>
        plan · overhead
      </span>
      <span class="legend-item">
        <span class="legend-swatch legend-actual-must"></span>
        actual · must
      </span>
      <span class="legend-item">
        <span class="legend-swatch legend-actual-overhead"></span>
        actual · overhead
      </span>
      <span class="legend-item">
        <span class="legend-glyph" aria-hidden="true">↑</span>
        overrun (&gt; {varianceFlagThreshold}× plan)
      </span>
      <span class="legend-item">
        <span class="legend-glyph" aria-hidden="true">↑ NNN</span>
        off-scale (&gt; median×2.5 cap)
      </span>
    </div>
  )}

  {footerText && (
    <p class="chart-footer">{footerText}</p>
  )}
</section>

<style>
  .stacked-comparison {
    position: relative;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    padding: var(--space-5);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    color: var(--fg-dim);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }
  .title .glyph {
    color: var(--accent);
    font-size: 0.65em;
  }

  .head-meta {
    font-size: var(--size-sm);
    color: var(--fg-dim);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .count       { color: var(--accent); font-weight: 600; }
  .axis-meta   { color: var(--fg); }
  .threshold   { color: var(--fg-dim); }
  .sep         { color: var(--muted); margin: 0 var(--space-2); }

  .chart-outer { display: flex; align-items: stretch; }

  .chart-wrap {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 220px;
  }

  .chart-svg { display: block; width: 100%; height: 100%; }

  .grid-line {
    stroke: var(--border);
    stroke-width: 0.5;
    stroke-dasharray: 1 3;
  }

  /* Column A (plan) — dimmed/muted family */
  .seg-plan-must {
    fill: var(--accent-dim);
    @media (prefers-reduced-motion: no-preference) {
      transition: opacity var(--motion-fast) var(--easing);
    }
  }
  .seg-plan-must:hover { opacity: 0.8; }

  .seg-plan-overhead {
    fill: var(--muted);
    @media (prefers-reduced-motion: no-preference) {
      transition: opacity var(--motion-fast) var(--easing);
    }
  }
  .seg-plan-overhead:hover { opacity: 0.8; }

  /* Column B (actual) — accent/accent-dim family */
  .seg-actual-must {
    fill: var(--accent);
    @media (prefers-reduced-motion: no-preference) {
      transition: opacity var(--motion-fast) var(--easing);
    }
  }
  .seg-actual-must:hover { opacity: 0.8; }

  .seg-actual-overhead {
    fill: var(--accent-dim);
    @media (prefers-reduced-motion: no-preference) {
      transition: opacity var(--motion-fast) var(--easing);
    }
  }
  .seg-actual-overhead:hover { opacity: 0.8; }

  .overrun-glyph {
    fill: var(--danger);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }

  /* S112: off-scale glyph (actuals exceeding median×2.5 cap) */
  .offscale-glyph {
    fill: var(--danger);
    font-family: var(--font-mono);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .cap-line {
    stroke: var(--muted);
    stroke-width: 0.75;
    stroke-dasharray: 3 2;
  }
  .cap-label {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.04em;
  }

  .empty-text {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ytick-text, .xtick-text {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .col-sublabel {
    fill: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
    font-size: 10px;
    color: var(--fg-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .legend-swatch {
    display: inline-block;
    width: 14px;
    height: 8px;
    flex-shrink: 0;
  }
  .legend-plan-must     { background: var(--accent-dim); }
  .legend-plan-overhead { background: var(--muted); }
  .legend-actual-must     { background: var(--accent); }
  .legend-actual-overhead { background: var(--accent-dim); }
  .legend-glyph {
    color: var(--danger);
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
  }

  .chart-footer {
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    color: var(--fg-dim);
    margin: var(--space-3) 0 0;
    letter-spacing: 0.02em;
    font-style: italic;
  }

  /* S113: overview strip + window indicator */
  .window-caption {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-1);
  }
  .overview-wrap {
    position: relative;
    height: 50px;
    width: 100%;
  }
  .overview-svg { display: block; width: 100%; height: 100%; }
  .ov-plan         { fill: var(--accent-dim); opacity: 0.5; }
  .ov-actual       { fill: var(--accent); }
  .ov-actual-overrun { fill: var(--danger); }
  .ov-baseline {
    stroke: var(--border);
    stroke-width: 0.5;
  }
  .window-rect {
    fill: var(--accent);
