  // SprintBurnup hidden-attribute pattern. One handler flips aria-pressed on the
  // buttons and shows/hides every [data-ms] element (chapters + sidebar blocks).
  // ALL reveals everything.
  (() => {
    const sw = document.querySelector('[data-ms-switch]');
    if (!sw) return;
    // Chapters: ALL reveals every milestone. Sidebar blocks: exact match, so ALL
    // shows only the aggregate block (not all four stacked).
    // [data-ms] covers both spine epochs and chapter wrappers (same toggle rule).
    const tagged = Array.from(document.querySelectorAll<HTMLElement>('[data-ms]'));
    const sideBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-ms-scope]'));
    const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-ms-count]'));
    const btns = Array.from(sw.querySelectorAll<HTMLButtonElement>('[data-ms-btn]'));

    function apply(scope: string) {
      for (const el of tagged) {
        el.hidden = scope !== 'ALL' && el.dataset.ms !== scope;
      }
      for (const el of sideBlocks) {
        el.hidden = el.dataset.msScope !== scope;
      }
      // Visible-epic count (count chapter wrappers only, not spine + chapters).
      const n = document.querySelectorAll('.ms-chapter:not([hidden])').length;
      for (const c of counters) c.textContent = String(n);
      for (const b of btns) {
        b.setAttribute('aria-pressed', b.dataset.msBtn === scope ? 'true' : 'false');
      }
    }

    sw.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ms-btn]');
      if (!btn || !btn.dataset.msBtn) return;
      apply(btn.dataset.msBtn);
    });
  })();
</script>
