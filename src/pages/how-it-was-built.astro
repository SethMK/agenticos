---
export const prerender = true;
/**
 * /how-it-was-built — S047 (E02) — hybrid redesign
 *
 * Layout: variant D (hybrid) per the S046 spike decision.
 *   - B-style headline stat row (6 large stat cards with corner brackets)
 *   - A-style spine timeline (horizontal 6-epic strip)
 *   - A-style epic chapters (vertical build-log narrative)
 *   - A-style right sidebar (build receipt + agent-loop ASCII)
 *
 * Data source: data/snapshots/public.json → snapshot.pmo + snapshot.totals.
 * No client JS. Static at build. Page weight target ≤ 50 KB gz.
 *
 * Heading hierarchy:
 *   TerminalLayout renders <h1 class="sr-only">AgenticOS</h1> (S027).
 *   This page uses <h1> for the page title.
 *   EpicChapter.astro uses <h2> for chapter headings.
 *   BuildReceipt.astro uses <h2> for sidebar section headings.
 */
import TerminalLayout from '../layouts/TerminalLayout.astro';
import SpineTimeline from '../components/SpineTimeline.astro';
import EpicChapter from '../components/EpicChapter.astro';
import BuildReceipt from '../components/BuildReceipt.astro';
import BurndownChart from '../components/BurndownChart.astro';
import SprintBurnup from '../components/SprintBurnup.astro';
import SprintVelocityTrend from '../components/SprintVelocityTrend.astro';
import SprintAccuracyTokens from '../components/SprintAccuracyTokens.astro';
import SprintAccuracyTime from '../components/SprintAccuracyTime.astro';
import snapshot from '../../data/snapshots/public.json';

// ── Type declarations ─────────────────────────────────────────────────────────

interface PmoStory {
  id: string;
  title?: string;
  status?: string;
  epic?: string;
  points?: number;
  size?: string;
  est_tokens_k?: number;
  est_minutes?: number;
}

interface PmoEpic {
  id: string;
  title: string;
  status: string;
  story_count: number;
  done_count: number;
}

interface PmoColumns {
  backlog: string[];
  ready: string[];
  in_progress: string[];
  review: string[];
  done: string[];
}

// ── Extract snapshot data ─────────────────────────────────────────────────────

const pmo = (snapshot as {
  pmo?: {
    columns?: PmoColumns;
    epics?: PmoEpic[];
    recent_stories?: PmoStory[];
    generated_at?: string;
  };
  totals?: {
    total_tokens?: number;
    total_subscription?: number;
    subscription_currency?: string;
    project_tokens_total?: number;
    project_tokens_input?: number;
    project_tokens_output?: number;
    [key: string]: unknown;
  };
}).pmo ?? {};

const totals = (snapshot as {
  totals?: {
    total_tokens?: number;
    project_tokens_total?: number;
    project_tokens_input?: number;
    project_tokens_output?: number;
    [key: string]: unknown;
  };
}).totals ?? {};

const columns: PmoColumns = pmo.columns ?? {
  backlog: [],
  ready: [],
  in_progress: [],
  review: [],
  done: [],
};
const epics: PmoEpic[] = pmo.epics ?? [];
const recentStories: PmoStory[] = pmo.recent_stories ?? [];

// ── Headline stat calculations ────────────────────────────────────────────────

const totalStories =
  columns.backlog.length +
  columns.ready.length +
  columns.in_progress.length +
  columns.review.length +
  columns.done.length;

const storiesDone = columns.done.length;
const epicsComplete = epics.filter(
  (e) => e.done_count === e.story_count && e.story_count > 0,
).length;
const epicsActive = epics.filter(
  (e) => e.status === 'active' || (e.done_count > 0 && e.done_count < e.story_count),
).length;

// Tokens: raw number, formatted as "60.8M" / "1.2k" / raw
// S076: use project-scoped all-time total (not global) — fail loud (0) on stale snapshot
const rawTokens = totals.project_tokens_total ?? 0;
function fmtTokensBig(t: number): string {
  if (t >= 1_000_000) return `${(t / 1_000_000).toFixed(1)}M`;
  if (t >= 1_000) return `${Math.round(t / 1000)}k`;
  return String(t);
}
const tokensFmt = fmtTokensBig(rawTokens);
// S076: subtitle split — input and output formatted separately
const tokensInFmt = fmtTokensBig(totals.project_tokens_input ?? 0);
const tokensOutFmt = fmtTokensBig(totals.project_tokens_output ?? 0);

// Wall clock: sum est_minutes across done stories in recent_stories only
// (older done stories in columns.done may not have est_minutes in the snapshot)
const wallClockMin = recentStories
  .filter((s) => s.status === 'done' && typeof s.est_minutes === 'number')
  .reduce((acc, s) => acc + (s.est_minutes ?? 0), 0);

function fmtWallClock(min: number): string {
  if (!min) return '—';
  if (min < 60) return `~${min}m`;
  const h = Math.floor(min / 60);
  const rem = min % 60;
  return rem ? `~${h}h ${rem}m` : `~${h}h`;
}
const wallClockFmt = fmtWallClock(wallClockMin);

// Weeks of Max (S061): project-scoped quota share — used_k / total_k gives share-of-week
const weeksOfMaxRaw =
  ((totals.weekly_quota_project_used_k as number | undefined) ?? 0) /
  ((totals.weekly_quota_project_total_k as number | undefined) ?? 180000);
const weeksOfMaxFmt = weeksOfMaxRaw < 0.1 ? '< 0.1 wk' : `${weeksOfMaxRaw.toFixed(1)} wk`;

// ── Story lookup ──────────────────────────────────────────────────────────────

const storyById = new Map<string, PmoStory>();
for (const s of recentStories) {
  if (s?.id) storyById.set(s.id, s);
}

// Build status map: id → status string (from columns, authoritative)
const storyStatus = new Map<string, string>();
for (const id of columns.backlog)     storyStatus.set(id, 'backlog');
for (const id of columns.ready)       storyStatus.set(id, 'ready');
for (const id of columns.in_progress) storyStatus.set(id, 'in-progress');
for (const id of columns.review)      storyStatus.set(id, 'review');
for (const id of columns.done)        storyStatus.set(id, 'done');

// For each epic, gather its stories from recent_stories (where epic field matches),
// plus include any done-column IDs not in recent_stories to preserve data per acceptance bullet 2.
// We also include all in_progress IDs belonging to this epic.
function storiesForEpic(epicId: string): PmoStory[] {
  const found: PmoStory[] = [];
  const seenIds = new Set<string>();

  // 1. All recent_stories that belong to this epic
  for (const s of recentStories) {
    if (s.epic === epicId) {
      found.push({ ...s, status: storyStatus.get(s.id) ?? s.status });
      seenIds.add(s.id);
    }
  }

  // 2. Any in_progress IDs not yet in recent_stories for this epic
  // (shouldn't happen but defensive)
  for (const id of columns.in_progress) {
    if (!seenIds.has(id)) {
      const st = storyById.get(id);
      if (st?.epic === epicId) {
        found.push({ ...st, status: 'in-progress' });
        seenIds.add(id);
      }
    }
  }

  // Sort: done first (descending id), then in-flight, then others (backlog/ready)
  const statusOrder = (s: PmoStory) => {
    const status = s.status;
    if (status === 'done') return 0;
    if (status === 'review') return 1;
    if (status === 'in-progress') return 2;
    if (status === 'ready') return 3;
    return 4; // backlog
  };

  found.sort((a, b) => {
    const so = statusOrder(a) - statusOrder(b);
    if (so !== 0) return so;
    // Within same status, sort by id descending (most recent first)
    return b.id.localeCompare(a.id);
  });

  return found;
}

// ── Narrative subtitles for each epic (optional flavour from variant D mockup) ─
const EPIC_SUBTITLES: Record<string, string> = {
  E01: 'laying the rails before the data could move.',
  E02: 'the page recruiters will actually open.',
  E03: 'the parts only Marcin should see.',
  E04: 'turning the static build into a public URL.',
  E05: 'the second pass that separates portfolio from project.',
  E06: 'second-pass numeracy on the numbers we already shipped.',
};

// IDs currently in flight
const inflightIds = columns.in_progress;

// ── All-IDs preservation for acceptance bullet 2 ─────────────────────────────
// Build a complete "full kanban" list of all story IDs across all columns.
// Stories that have an epic mapping appear in the chapter log above.
// Stories without an epic mapping (no entry in recent_stories) still need to
// appear in the page — they're surfaced here in a compact archive section.
const allKanbanIds: Array<{ id: string; status: string; title?: string }> = [];
const mappedIds = new Set<string>(recentStories.map((s) => s.id));

function addIds(ids: string[], status: string) {
  for (const id of ids) {
    const story = storyById.get(id);
    allKanbanIds.push({ id, status, title: story?.title });
  }
}
addIds(columns.done, 'done');
addIds(columns.in_progress, 'in-progress');
addIds(columns.review, 'review');
addIds(columns.ready, 'ready');
addIds(columns.backlog, 'backlog');

// IDs NOT in recent_stories (no epic mapping): need the catch-all section
const unmappedIds = allKanbanIds.filter((s) => !mappedIds.has(s.id));

// ── Section rule helper ───────────────────────────────────────────────────────
// (rendered as static text — no component needed for a one-liner)
---

<TerminalLayout title="AGENTICOS — /how-it-was-built">
  <div class="hiw-page" id="main-content">

    <!-- 1. Page h1 + lead paragraph -->
    <h1 class="page-title">
      How this dashboard <span class="path">/</span> was built.
    </h1>
    <p class="lede">
      Every visual on this site was shipped by an <em>orchestrator</em> pulling one kanban card
      at a time, dispatching an <em>implementer</em> sub-agent to write the code and a
      <em>qa-verifier</em> sub-agent to check the acceptance bullets.
      <span class="accent">{totalStories} stories, {epics.length} epics, {storiesDone} already shipped</span> — the receipt is below.
    </p>

    <!-- S091: 3 text sections BEFORE all existing content (after lede) -->

    <!-- Problem Statement -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · problem statement</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>
    <section class="s091-text-section" aria-label="Problem statement">
      <h2 class="s091-section-heading">Problem</h2>
      <p class="s091-body">
        Personal development under a Claude Max weekly token cap requires predictable, controlled token burn.
        The existing kanban tracks WHAT (stories shipped) but not HOW MUCH (tokens consumed) or HOW FAST
        (wall-clock minutes elapsed). Without structure, story-by-story pulls drift into runaway sessions
        that exhaust the weekly quota. Before this approach, a single deep-work session burned 1.5M tokens
        in 90 minutes with no checkpoint.
      </p>
      <p class="s091-body">
        The token window resets weekly but session overhead compounds: every tool-call, re-read of context,
        and orchestrator round-trip adds silent overhead that is invisible in the kanban view. Scope creep
        inside a session is the dominant failure mode — a "quick" feature pull balloons into re-reading
        three agent docs and refactoring a shared component, consuming three times the estimated budget
        before the acceptance bullets are even checked.
      </p>
    </section>

    <!-- Solution -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · solution</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>
    <section class="s091-text-section" aria-label="Solution">
      <h2 class="s091-section-heading">Solution</h2>
      <p class="s091-body">
        The sprint-planner approach: 1-hour time-boxed sprints with MoSCoW-lite scope contract
        (must-haves WILL ship, should-haves are droppable), two-budget tracking (work + overhead),
        token-budget guard rails at 50/75/90/100% with hard-stop at 100%, role-based ceremony
        (SM + PO sonnet agents + PM human), retro-driven self-improvement. Predictable cycles,
        droppable scope, hard limits.
      </p>
      <p class="s091-body">
        Each sprint opens with <code class="s091-code">/sprint-plan</code>: SM recommends capacity,
        PO recommends story basket, PM negotiates scope and confirms. Execution runs a 60-minute
        WIP=2 window — at most two stories in-flight simultaneously. Sprint closes with
        <code class="s091-code">/sprint-close</code>: compute actuals, write demo dashboard,
        four-agent parallel retro, decision sweep. The chain decision at close either loops to
        the next sprint or halts. Guard rails enforce the budget contract so no session can silently
        overrun.
      </p>
    </section>

    <!-- Project Division -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · project division</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>
    <section class="s091-text-section" aria-label="Project division">
      <h2 class="s091-section-heading">Project Division</h2>
      <p class="s091-body">
        Milestone → Epic → Story hierarchy. M1 contains 8 shipped epics (E01–E08, the foundation
        pipeline + dashboard). M2 is in progress (E09 Sprint Planner: 7/9 stories done).
        M3 is deferred (E10 Productization). Stories sit under Epics; Epics roll up into Milestones;
        Milestones are quarterly arcs.
      </p>
      <!-- TODO: migrate to pmo.milestones[] once export schema adds the field -->
      <div class="s091-milestone-grid" aria-label="Milestone summary">
        <div class="s091-milestone">
          <span class="s091-m-label">M1</span>
          <span class="s091-m-count">8 epics</span>
          <span class="s091-m-detail">E01–E08 · shipped · foundation pipeline + dashboard</span>
          <span class="s091-m-stories">~91 stories done</span>
        </div>
        <div class="s091-milestone">
          <span class="s091-m-label">M2</span>
          <span class="s091-m-count">1 epic (in progress)</span>
          <span class="s091-m-detail">E09 · Sprint Planner · 7/9 stories done</span>
          <span class="s091-m-stories">7 done, 2 remaining</span>
        </div>
        <div class="s091-milestone">
          <span class="s091-m-label">M3</span>
          <span class="s091-m-count">0 epics (deferred)</span>
          <span class="s091-m-detail">E10 · Productization · not started</span>
          <span class="s091-m-stories">0 stories done</span>
        </div>
      </div>
    </section>

    <!-- 2. Headline stat row (B-style, 6 cards with corner brackets) -->
    <section class="stat-row" aria-label="Headline build stats">
      <span class="corner tl" aria-hidden="true"></span>
      <span class="corner tr" aria-hidden="true"></span>
      <span class="corner bl" aria-hidden="true"></span>
      <span class="corner br" aria-hidden="true"></span>

      <div class="stat-cell">
        <div class="stat-k">Stories Total</div>
        <div class="stat-v">{totalStories}</div>
        <div class="stat-sub">across {epics.length} epics</div>
      </div>
      <div class="stat-cell">
        <div class="stat-k">Stories Done</div>
        <div class="stat-v accent">{storiesDone}</div>
        <div class="stat-sub">{Math.round((storiesDone / totalStories) * 100)}% · status:done</div>
      </div>
      <div class="stat-cell">
        <div class="stat-k">Epics Complete</div>
        <div class="stat-v">{epicsComplete}</div>
        <div class="stat-sub">{epics.filter(e => e.done_count === e.story_count && e.story_count > 0).map(e => e.id).join(' · ') || '—'}</div>
      </div>
      <div class="stat-cell">
        <div class="stat-k">Epics Active</div>
        <div class="stat-v">{epicsActive}</div>
        <div class="stat-sub">{epics.filter(e => e.status === 'active' || (e.done_count > 0 && e.done_count < e.story_count)).map(e => e.id).join(' · ') || '—'}</div>
      </div>
      <div class="stat-cell">
        <div class="stat-k">Tokens Burned</div>
        <div class="stat-v">{tokensFmt}</div>
        <div class="stat-sub">{tokensInFmt} input · {tokensOutFmt} output</div>
      </div>
      <div class="stat-cell">
        <div class="stat-k">Weeks of Max</div>
        <div class="stat-v">{weeksOfMaxFmt}</div>
        <div class="stat-sub">(est.)</div>
      </div>
    </section>

    <!-- 3. Burndown chart (S060) — snapshot + projection -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">quota · burnup / snapshot + projection</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>

    <BurndownChart />

    <p class="chart-footnote">
      Anthropic does not publish the exact Max 5x weekly token cap. The denominator uses a community-inferred estimate of ~180M tokens per week (the estimated global Max 5x budget). The projection band shows a 1.45×–1.86× bias-correction range derived from six-epic project actuals.
    </p>

    <!-- Sprint burnup (S088 component, S089 mount) — live SPR-NNN execution -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · live execution burnup</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>

    <SprintBurnup />

    <!-- Sprint velocity trend (S096) — cross-sprint stacked bars -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · velocity trend across closed sprints</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>

    <SprintVelocityTrend />

    <!-- Sprint accuracy (tokens) (S094) — plan-vs-actual stacked bars -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · accuracy (tokens)</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>

    <SprintAccuracyTokens />

    <!-- Sprint accuracy (time) (S095) — plan-vs-actual wall-clock stacked bars -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · accuracy (time)</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>

    <SprintAccuracyTime />

    <!-- S091: 3 diagram sections — Sprint Loop, Process Roles, Dev-Team Mapping -->

    <!-- Sprint Loop Diagram -->
    <div class="section-rule" aria-hidden="true">
      <span class="rule-line">──────────────────────────────────────</span>
      <span class="rule-label">sprint · loop diagram</span>
      <span class="rule-line">──────────────────────────────────────</span>
    </div>
    <section class="s091-diagram-section" aria-label="Sprint loop flow diagram">
      <h2 class="s091-section-heading">Sprint Loop</h2>
      <p class="s091-diagram-caption">
        Top-down execution flow: planning ceremony → EXECUTION window (60 min, WIP=2) →
        close ceremony → chain decision. Guard rails enforce token budget contract.
        Shapes: rectangles = phases, diamonds = decision gates, parallelograms = actions.
      </p>

      <div class="s091-diagram-wrap">
        <svg
          class="s091-svg"
          viewBox="0 0 480 920"
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="Sprint loop: /sprint-plan → budget check → basket selection → EXECUTION → /sprint-close → retro → CHAIN decision"
        >
          <!-- PLANNING PHASE nodes (solid --accent border) -->
          <!-- /sprint-plan -->
          <rect class="node-plan" x="140" y="20" width="200" height="44" />
          <!-- Q0 staleness? -->
          <polygon class="node-decision" points="240,90 320,114 240,138 160,114" />
          <!-- refresh pipeline (conditional action) -->
          <rect class="node-action" x="345" y="100" width="115" height="28" rx="2" />
          <!-- Q1 budget % -->
          <polygon class="node-decision" points="240,164 320,188 240,212 160,188" />
          <!-- Q2 source split -->
          <polygon class="node-decision" points="240,228 320,252 240,276 160,252" />
          <!-- Q3 story basket -->
          <polygon class="node-decision" points="240,292 320,316 240,340 160,316" />
          <!-- Q4 improvement (conditional) -->
          <polygon class="node-decision" points="240,356 320,380 240,404 160,380" />
          <!-- confirm -->
          <parallelogram-placeholder />
          <polygon class="node-action-para" points="170,420 310,420 330,448 150,448" />

          <!-- EXECUTION PHASE node -->
          <!-- EXECUTION box -->
          <rect class="node-exec" x="120" y="474" width="240" height="52" />

          <!-- CLOSE PHASE nodes (--accent-dim border) -->
          <!-- /sprint-close -->
          <rect class="node-close" x="140" y="556" width="200" height="44" />
          <!-- compute actuals -->
          <polygon class="node-action-para-close" points="170,618 310,618 330,646 150,646" />
          <!-- write Demo dashboard -->
          <polygon class="node-action-para-close" points="170,656 310,656 330,684 150,684" />
          <!-- retro proposal (4-agent parallel) -->
          <polygon class="node-action-para-close" points="170,694 310,694 330,722 150,722" />
          <!-- decision sweep -->
          <polygon class="node-action-para-close" points="170,732 310,732 330,760 150,760" />

          <!-- CHAIN decision diamond -->
          <polygon class="node-decision-chain" points="240,790 330,820 240,850 150,820" />

          <!-- Connector arrows (vertical flow) -->
          <!-- /sprint-plan → Q0 -->
          <line class="flow-arrow" x1="240" y1="64" x2="240" y2="90" marker-end="url(#arrowhead)" />
          <!-- Q0 → Q1 (straight) -->
          <line class="flow-arrow" x1="240" y1="138" x2="240" y2="164" marker-end="url(#arrowhead)" />
          <!-- Q0 → refresh pipeline (side branch) -->
          <line class="flow-arrow-dim" x1="320" y1="114" x2="345" y2="114" marker-end="url(#arrowhead-dim)" />
          <!-- refresh → back to Q0 -->
          <path class="flow-arrow-dim" d="M 460 114 Q 470 80 410 74 Q 380 68 330 75" fill="none" marker-end="url(#arrowhead-dim)" />
          <!-- Q1 → Q2 -->
          <line class="flow-arrow" x1="240" y1="212" x2="240" y2="228" marker-end="url(#arrowhead)" />
          <!-- Q2 → Q3 -->
          <line class="flow-arrow" x1="240" y1="276" x2="240" y2="292" marker-end="url(#arrowhead)" />
          <!-- Q3 → Q4 -->
          <line class="flow-arrow" x1="240" y1="340" x2="240" y2="356" marker-end="url(#arrowhead)" />
          <!-- Q4 → confirm -->
          <line class="flow-arrow" x1="240" y1="404" x2="240" y2="420" marker-end="url(#arrowhead)" />
          <!-- confirm → EXECUTION -->
          <line class="flow-arrow" x1="240" y1="448" x2="240" y2="474" marker-end="url(#arrowhead)" />
          <!-- EXECUTION → /sprint-close -->
          <line class="flow-arrow" x1="240" y1="526" x2="240" y2="556" marker-end="url(#arrowhead)" />
          <!-- /sprint-close → compute actuals -->
          <line class="flow-arrow" x1="240" y1="600" x2="240" y2="618" marker-end="url(#arrowhead)" />
          <!-- compute actuals → write demo -->
          <line class="flow-arrow" x1="240" y1="646" x2="240" y2="656" marker-end="url(#arrowhead)" />
          <!-- write demo → retro -->
          <line class="flow-arrow" x1="240" y1="684" x2="240" y2="694" marker-end="url(#arrowhead)" />
          <!-- retro → decision sweep -->
          <line class="flow-arrow" x1="240" y1="722" x2="240" y2="732" marker-end="url(#arrowhead)" />
          <!-- decision sweep → CHAIN -->
          <line class="flow-arrow" x1="240" y1="760" x2="240" y2="790" marker-end="url(#arrowhead)" />
          <!-- CHAIN → yes loop back to /sprint-plan -->
          <path class="flow-arrow-loop" d="M 150 820 Q 80 820 80 42 Q 80 10 140 10" fill="none" marker-end="url(#arrowhead-loop)" />
          <!-- CHAIN → no → done -->
          <line class="flow-arrow-done" x1="330" y1="820" x2="400" y2="820" marker-end="url(#arrowhead-done)" />

          <!-- Arrow marker definitions -->
          <defs>
            <marker id="arrowhead" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
              <path d="M 0 0 L 6 3 L 0 6 Z" class="arrow-fill" />
            </marker>
            <marker id="arrowhead-dim" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
              <path d="M 0 0 L 6 3 L 0 6 Z" class="arrow-fill-dim" />
            </marker>
            <marker id="arrowhead-loop" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
              <path d="M 0 0 L 6 3 L 0 6 Z" class="arrow-fill-loop" />
            </marker>
